# --- Raw material. Never commit. ---
# These are copyrighted papers and their full text. They are large, and they
# cannot be redistributed. Every dataset row records the document and line it
# came from, so anyone holding the same corpus can rebuild a passage.
*.zip
*.pdf
statcheck-ml/data/
# The archive extracts to this name at the repository root. The files inside are
# full text, not PDF, so the rules above do not catch them. Without this line
# `git add -A` stages 3000 copyrighted articles.
02_pdfs/

# --- Derived dataset. This IS committed. ---
# Short annotated excerpts and their labels. The rule above ignores the whole
# data directory, so the dataset lives outside it, in statcheck-ml/dataset/.
!statcheck-ml/dataset/
!statcheck-ml/dataset/**

# Models and checkpoints
*.onnx
*.pt
*.ckpt
checkpoints/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node
node_modules/

# R
.Rhistory
.RData

# Virtual environment
.venv/
*.egg-info/

# Trained models are rebuilt from the dataset, but keep the zoo and manifests
statcheck-ml/models/
!statcheck-ml/models/
statcheck-ml/models/*
!statcheck-ml/models/zoo/
!statcheck-ml/models/zoo/**
!statcheck-ml/models/*.onnx
!statcheck-ml/models/runs.json
!statcheck-ml/models/export.json

# Results are committed
!statcheck-ml/results/
!statcheck-ml/results/**
